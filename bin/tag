#!/bin/bash

WD=`pwd`
REGEX='^v0\.[0-9]+\.[0-9]+\.?[0-9]?$'

if [[ $# < 1 ]]; then
   echo "Usage: tag <version>"
   exit 1
fi

if [[ ! $1 =~ $REGEX ]]; then
   echo "Error: Tag must match regular expression $REGEX"
   exit 1
fi

cd ~/ship-tool
for d in frontend backend data; do
   cd $d
   git tag $1
   git push --tags
   cd ..
done

cd $WD